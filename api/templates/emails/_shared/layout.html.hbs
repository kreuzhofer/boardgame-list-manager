<!DOCTYPE html>
<html lang="{{lang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{subject}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet" />
  </head>
  <body class="email-field">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-field">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" class="email-card">

            <tr>
              <td class="email-header">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="email-mark-cell">
                      <img src="cid:wg-logo" alt="" width="40" height="40" class="email-mark" />
                    </td>
                    <td class="email-wordmark">Brettspieltreff</td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr><td class="email-rule">&nbsp;</td></tr>

            <tr>
              <td class="email-body">
                {{{body}}}
              </td>
            </tr>

            <tr><td class="email-rule">&nbsp;</td></tr>

            <tr>
              <td class="email-footer">
                {{{footer}}}
              </td>
            </tr>

          </table>

          <p class="email-attribution">
            Brettspieltreff &middot; <a href="{{appUrl}}">{{appUrlDisplay}}</a>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
