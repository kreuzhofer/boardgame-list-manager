generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  eventId    String?   @map("event_id")
  name       String   @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  players    Player[]
  bringers   Bringer[]
  ownedGames Game[]
  hiddenGames HiddenGame[]
  activityEvents ActivityEvent[]
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@index([eventId])
  @@map("users")
}

model Game {
  id                    String   @id @default(uuid())
  eventId               String?   @map("event_id")
  name                  String
  ownerId               String?  @map("owner_id")
  bggId                 Int?     @map("bgg_id")
  yearPublished         Int?     @map("year_published")
  bggRating             Float?   @map("bgg_rating")
  addedAsAlternateName  String?  @map("added_as_alternate_name") @db.VarChar(255)
  alternateNames        Json     @default("[]") @map("alternate_names") @db.JsonB
  isPrototype           Boolean  @default(false) @map("is_prototype")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  owner                 User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  players               Player[]
  bringers              Bringer[]
  hiddenBy              HiddenGame[]
  activityEvents        ActivityEvent[]
  event                 Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([bggId])
  @@index([eventId])
  @@unique([eventId, name])
  @@map("games")
}

model Player {
  id       String   @id @default(uuid())
  gameId   String   @map("game_id")
  userId   String   @map("user_id")
  addedAt  DateTime @default(now()) @map("added_at")
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("players")
}

model Bringer {
  id       String   @id @default(uuid())
  gameId   String   @map("game_id")
  userId   String   @map("user_id")
  addedAt  DateTime @default(now()) @map("added_at")
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("bringers")
}

model HiddenGame {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("hidden_games")
}

model Event {
  id             String   @id @default(uuid())
  name           String
  slug           String?  @unique
  password       String?
  status         String   @default("planning") // planning | active | archived
  description    String?  @db.Text
  welcomeMessage String?  @db.Text @map("welcome_message")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  location       String?  @db.VarChar(255)
  capacity       Int?
  notes          String?  @db.Text
  fees           String?  @db.Text
  isDefault      Boolean  @default(false) @map("is_default")
  ownerAccountId String   @map("owner_account_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ownerAccount   Account  @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  participants   User[]
  games          Game[]
  activityEvents ActivityEvent[]

  @@index([ownerAccountId])
  @@map("events")
}

enum ActivityEventType {
  game_created
  player_added
  player_removed
  bringer_added
  bringer_removed
  game_deleted
  game_hidden
  game_unhidden
  prototype_toggled
  user_created
}

model ActivityEvent {
  id          String            @id @default(uuid())
  actorUserId String            @map("actor_user_id")
  eventType   ActivityEventType @map("event_type")
  gameId      String?           @map("game_id")
  eventId     String?           @map("event_id")
  metadata    Json?             @map("metadata") @db.JsonB
  createdAt   DateTime          @default(now()) @map("created_at")
  actor       User              @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  game        Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([gameId])
  @@index([eventId])
  @@index([createdAt])
  @@index([eventType])
  @@map("activity_events")
}

model BggGame {
  id                  Int       @id @map("bgg_id")
  name                String
  yearPublished       Int?      @map("year_published")
  rank                Int?
  bayesAverage        Float?    @map("bayes_average")
  average             Float?
  usersRated          Int?      @map("users_rated")
  isExpansion         Boolean   @default(false) @map("is_expansion")
  
  // Category-specific ranks
  abstractsRank       Int?      @map("abstracts_rank")
  cgsRank             Int?      @map("cgs_rank")
  childrensGamesRank  Int?      @map("childrensgames_rank")
  familyGamesRank     Int?      @map("familygames_rank")
  partyGamesRank      Int?      @map("partygames_rank")
  strategyGamesRank   Int?      @map("strategygames_rank")
  thematicRank        Int?      @map("thematic_rank")
  warGamesRank        Int?      @map("wargames_rank")
  
  // Enrichment fields
  scrapingDone        Boolean   @default(false) @map("scraping_done")
  enrichedAt          DateTime? @map("enriched_at")
  enrichmentData      Json?     @map("enrichment_data") @db.JsonB
  
  // Timestamps
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("bgg_games")
}

// Account Management Models

enum AccountRole {
  account_owner
  admin
}

enum AccountStatus {
  active
  deactivated
  unverified
}

model Account {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         AccountRole   @default(account_owner)
  status       AccountStatus @default(active)
  /// ISO 639-1 language tag, e.g. 'de', 'en'. Drives email-template
  /// locale resolution. Null = use default ('de').
  locale       String?       @db.VarChar(8)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     Session[]
  events       Event[]
  loginTokens  LoginToken[]

  @@map("accounts")
}

/// Single-use, time-limited tokens for magic-link login (and future
/// invitation / password-reset flows that need a one-shot URL).
model LoginToken {
  id          String    @id @default(uuid())
  /// Random URL-safe token (~32 bytes). Indexed for the consume lookup.
  token       String    @unique
  accountId   String    @map("account_id")
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// What the token is for. Lets us route on consume + log usage.
  purpose     String    /// 'login' | 'invite-claim' | 'legacy-claim' | 'reset-password' | 'email-change'
  /// Optional URL to land on after consumption (e.g. the event slug the
  /// invite was sent for). Null falls back to /events.
  targetPath  String?   @map("target_path")
  /// For purpose='email-change': the new email address the user wants
  /// to switch to. Null for any other purpose. Stored alongside the
  /// token so the consume step has everything it needs.
  newEmail    String?   @map("new_email")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  /// IP address of the consumer (for audit; null for unconsumed)
  consumedIp  String?   @map("consumed_ip")

  @@index([accountId])
  @@index([expiresAt])
  @@map("login_tokens")
}

model Session {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

/// One row per BMC supporter (deduped by `bmcSupporterId`). Donations and
/// subscriptions FK to this. Lets us answer "all activity by John" with a
/// simple JOIN. Anonymous events (no BMC supporter id) keep the FK null.
model Supporter {
  id              String    @id @default(uuid())
  bmcSupporterId  Int       @unique @map("bmc_supporter_id")
  name            String?
  email           String?
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")

  donations       Donation[]
  subscriptions   Subscription[]

  @@index([email])
  @@map("supporters")
}

model Donation {
  id                  String    @id @default(uuid())
  // BMC payment id — unique per donation event. Used for idempotent upserts
  // when BMC retries a webhook.
  bmcPaymentId        Int       @unique @map("bmc_payment_id")
  // Webhook event type, e.g. "donation.created", "donation.refunded".
  // Only "donation.created" creates rows here today; refunds update the
  // existing row's `refunded` flag.
  type                String
  // BMC test mode flag — false when this is a real donation.
  liveMode            Boolean   @default(false) @map("live_mode")
  // Donation amount in `currency` (numeric to keep cents). e.g. 5.00, 5.45.
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @db.VarChar(8)
  coffeeCount         Int?      @map("coffee_count")
  coffeePrice         Decimal?  @db.Decimal(10, 2) @map("coffee_price")
  // Total charged including fees, as reported by BMC (string field on
  // payload, parsed to decimal). Null if not provided.
  totalAmountCharged  Decimal?  @db.Decimal(10, 2) @map("total_amount_charged")
  applicationFee      Decimal?  @db.Decimal(10, 2) @map("application_fee")
  // Supporter FK — nullable for anonymous donations. Cascades to SET NULL
  // if a supporter row is deleted (donation history is preserved).
  supporterId         String?   @map("supporter_id")
  supporter           Supporter? @relation(fields: [supporterId], references: [id], onDelete: SetNull)
  supportNote         String?   @db.Text @map("support_note")
  message             String?   @db.Text
  status              String?
  refunded            Boolean   @default(false)
  refundedAt          DateTime? @map("refunded_at")
  transactionId       String?   @map("transaction_id")
  // Timestamps
  bmcCreatedAt        DateTime  @map("bmc_created_at")
  receivedAt          DateTime  @default(now()) @map("received_at")
  // Full raw webhook body for forensics / replay
  rawPayload          Json      @map("raw_payload")

  @@index([bmcCreatedAt])
  @@index([liveMode, refunded])
  @@index([supporterId])
  @@map("donations")
}

/// Ongoing supporter subscriptions. Covers both BMC `recurring_donation` and
/// `membership` events — they share an identical shape; memberships add the
/// `membership_level_*` fields. The `kind` discriminator + `bmcSubscriptionId`
/// form a composite unique key (BMC's id space overlaps between the two kinds).
model Subscription {
  id                   String    @id @default(uuid())
  bmcSubscriptionId    Int       @map("bmc_subscription_id")
  /// 'recurring' | 'membership'
  kind                 String
  liveMode             Boolean   @default(false) @map("live_mode")
  /// Per-period amount, e.g. 5.00 / month
  amount               Decimal   @db.Decimal(10, 2)
  currency             String    @db.VarChar(8)
  /// 'month' | 'year' (so far)
  durationType         String?   @map("duration_type")
  /// Stripe subscription id ("sub_…")
  pspId                String?   @map("psp_id")
  /// 'active' | 'canceled' | …
  status               String
  paused               Boolean   @default(false)
  canceled             Boolean   @default(false)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  /// Membership tier metadata, only for kind='membership'.
  membershipLevelId    Int?      @map("membership_level_id")
  membershipLevelName  String?   @map("membership_level_name")
  /// Supporter FK — nullable for anonymous subscriptions (rare).
  supporterId          String?   @map("supporter_id")
  supporter            Supporter? @relation(fields: [supporterId], references: [id], onDelete: SetNull)
  supportNote          String?   @db.Text @map("support_note")
  /// Free-text feedback, e.g. "Cancelled from stripe dashboard"
  supporterFeedback    String?   @db.Text @map("supporter_feedback")
  startedAt            DateTime  @map("started_at")
  canceledAt           DateTime? @map("canceled_at")
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  bmcCreatedAt         DateTime  @map("bmc_created_at")
  receivedAt           DateTime  @default(now()) @map("received_at")
  rawPayload           Json      @map("raw_payload")

  @@unique([kind, bmcSubscriptionId])
  @@index([supporterId])
  @@index([liveMode, status])
  @@index([pspId])
  @@map("subscriptions")
}

