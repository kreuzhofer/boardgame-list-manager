<!DOCTYPE html>
<html lang="{{lang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{subject}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f7f1e6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#2d2233;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f1e6;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;width:100%;background:#fdf9ee;border:1px solid #e3d5b8;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="background:#4a2540;padding:24px 28px;color:#fdf9ee;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="vertical-align:middle;padding-right:12px;">
                      <div style="width:36px;height:36px;border-radius:8px;background:#e8c75c;color:#4a2540;text-align:center;line-height:36px;font-style:italic;font-weight:700;font-size:22px;font-family:Georgia,serif;">W</div>
                    </td>
                    <td style="vertical-align:middle;font-style:italic;font-size:20px;font-family:Georgia,serif;">
                      Brettspieltreff
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:32px 28px 24px;">
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td style="padding:18px 28px;background:#ede4d0;border-top:1px solid #e3d5b8;font-size:12px;color:#5b4866;line-height:1.5;">
                {{{footer}}}
              </td>
            </tr>
          </table>
          <p style="margin:18px 0 0;font-size:11px;color:#8c7d92;text-align:center;">
            Brettspieltreff &middot; <a href="{{appUrl}}" style="color:#6b3a5c;text-decoration:none;">{{appUrlDisplay}}</a>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
